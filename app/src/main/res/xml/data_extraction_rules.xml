<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules for Android 12+ — exclude sensitive data -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude the session store (contains access/refresh tokens) -->
        <exclude domain="sharedpref" path="mallu_cupid_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Allow session transfer between user's own devices -->
        <include domain="sharedpref" path="mallu_cupid_session.xml"/>
    </device-transfer>
</data-extraction-rules>
